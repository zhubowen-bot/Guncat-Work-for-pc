store-dir=./.pnpm-store
cache-dir=./.pnpm-store/cache
strict-peer-dependencies=false
auto-install-peers=true
# Windows 上 pnpm 默认用 junction 组织 node_modules，Node 的 ESM 解析器在本机
# 不会把 junction 还原成真实路径，导致 vite/electron-vite 找不到自己依赖的
# rollup、cac 等包。改用扁平（npm 式）布局后这类解析问题全部消失。
node-linker=hoisted
# 依赖已安装时不要在每次 run 前重新校验并触发 postinstall
verify-deps-before-run=false
