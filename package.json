{
  "name": "guncat-work",
  "version": "0.1.0",
  "description": "Guncat Work 电脑版 —— Electron + React + TypeScript 实现的 Agent Harness 桌面客户端",
  "main": "./out/main/index.js",
  "author": "zhubowen-bot",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs dev",
    "build": "node scripts/build.mjs build",
    "start": "node scripts/build.mjs preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "verify": "npm run typecheck && npm run smoke",
    "smoke": "npm run build && node scripts/run-smoke.mjs && node scripts/render-check.mjs && node scripts/ipc-check.mjs && node scripts/startup-check.mjs",
    "smoke:core": "node scripts/run-smoke.mjs",
    "smoke:render": "node scripts/render-check.mjs",
    "smoke:ipc": "node scripts/ipc-check.mjs",
    "smoke:startup": "node scripts/startup-check.mjs",
    "dump:components": "node scripts/dump-components.mjs",
    "dist": "npm run build && node scripts/package-portable.mjs",
    "dist:only": "node scripts/package-portable.mjs"
  },
  "//dependencies": "本应用的运行时代码全部由 vite 打进 out/，因此没有 runtime dependencies —— 这也是 electron-builder 能干净出包的前提。下面这些包只参与构建。",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "katex": "^0.16.22",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.14",
    "zustand": "^5.0.8"
  }
}
