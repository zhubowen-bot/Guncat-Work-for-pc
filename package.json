{
  "name": "guncat-work",
  "version": "0.1.0",
  "description": "Guncat Work 电脑版 —— Electron + React + TypeScript 实现的 Agent Harness 桌面客户端",
  "main": "./out/main/index.js",
  "author": "zhubowen-bot",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "smoke": "node scripts/run-smoke.mjs && node scripts/render-check.mjs",
    "smoke:core": "node scripts/run-smoke.mjs",
    "smoke:render": "node scripts/render-check.mjs",
    "dump:components": "node scripts/dump-components.mjs",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "fast-xml-parser": "^5.2.5",
    "fflate": "^0.8.2",
    "katex": "^0.16.22",
    "mermaid": "^11.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.14"
  }
}
